   "source": [
    "### json.dump() — write json to a file"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "db99d325",
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "\n",
    "with open(\"text.json\", \"r\") as f:\n",
    "    data = json.load(f)\n",
    "\n",
    "with open(\"demo.json\", \"w\") as f:\n",
    "    json.dump(data, f)"
   ]
  }
